# syntax=docker/dockerfile:1
ARG BASE_IMAGE=nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04
ARG PYTHON_BASE_STAGE=system-python
ARG PYTHON_ENV_STAGE=copied-venv
ARG TTSFRD_BASE_STAGE=light-tts
FROM ${BASE_IMAGE} AS cuda-runtime

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential ca-certificates ffmpeg libasound2 libsndfile1 libsox-dev sox \
    && rm -rf /var/lib/apt/lists/*

FROM cuda-runtime AS system-python
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

FROM cuda-runtime AS standalone-python
ARG PYTHON_BASE_PREFIX=/opt/python
COPY --from=python_install / ${PYTHON_BASE_PREFIX}/

FROM ${PYTHON_BASE_STAGE} AS copied-venv
COPY --from=tts_venv / /usr/local/tts/.venv/

FROM system-python AS downloaded-venv
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3.10-venv \
    && rm -rf /var/lib/apt/lists/*
COPY requirements_lighttts.txt requirements_lighttts_constraints.txt /tmp/lighttts-deps/
RUN --mount=type=cache,target=/root/.cache/pip <<'SH'
set -eu
cd /tmp/lighttts-deps
export PIP_DISABLE_PIP_VERSION_CHECK=1
export PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
export PIP_TIMEOUT=120
export PIP_RETRIES=8
venv_dir=/usr/local/tts/.venv
python="$venv_dir/bin/python"

/usr/bin/python3.10 -m venv "$venv_dir"
"$python" -m pip install 'pip==24.3.1'
# Fetch just the CUDA wheels from PyTorch. Resolve their dependencies via the mirror.
echo 'Downloading PyTorch CUDA 12.1 wheels from download.pytorch.org'
"$python" -m pip download --no-deps --only-binary=:all: --dest pytorch-wheels \
    --index-url https://download.pytorch.org/whl/cu121 \
    'torch==2.3.1+cu121' 'torchaudio==2.3.1+cu121'
sed -n '/^sympy==/p; /^mpmath==/p' requirements_lighttts.txt > pytorch-constraints.txt
echo 'Installing PyTorch wheels and resolving dependencies from the PyPI mirror'
"$python" -m pip install -c pytorch-constraints.txt \
    pytorch-wheels/torch-*.whl pytorch-wheels/torchaudio-*.whl
rm -rf pytorch-wheels

# Whisper 20240930 imports pkg_resources in its isolated wheel build.
printf '%s\n' 'setuptools==75.8.0' > build-constraints.txt
PIP_CONSTRAINT="$PWD/build-constraints.txt" "$python" -m pip install \
    -r requirements_lighttts.txt -c requirements_lighttts_constraints.txt \
    'pynini==2.1.5' 'nvidia-ml-py==13.590.44'

# ORT 1.18.0 needs the CUDA 12 build from Microsoft's feed.
echo 'Downloading ONNX Runtime CUDA 12 wheel from the Microsoft feed'
"$python" -m pip download --no-deps -c requirements_lighttts_constraints.txt \
    --index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/ \
    onnxruntime-gpu
"$python" -m pip install ./onnxruntime_gpu-*.whl
echo 'Installing TensorRT with the NVIDIA package index'
"$python" -m pip install -c requirements_lighttts_constraints.txt \
    --extra-index-url https://pypi.nvidia.com \
    tensorrt-cu12 tensorrt-cu12-bindings tensorrt-cu12-libs

# Match install.sh's Triton override after resolving the other packages.
"$python" -m pip install --no-deps 'triton==3.1.0'
rm -rf /tmp/lighttts-deps
SH

FROM ${PYTHON_ENV_STAGE} AS light-tts
ARG PYTHON_VERSION
ENV VIRTUAL_ENV=/usr/local/tts/.venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /usr/local/tts/LightTTS
COPY light_tts/ light_tts/
COPY cosyvoice/ cosyvoice/
COPY third_party/ third_party/
COPY assets/ assets/
COPY voices.yaml ./

# CosyVoice looks for ttsfrd resources relative to its own source tree.
RUN mkdir -p pretrained_models && ln -s ../pretrained_models cosyvoice/pretrained_models

RUN "$VIRTUAL_ENV/bin/python" - <<'PY'
import os
import sys

assert sys.prefix == os.environ["VIRTUAL_ENV"], sys.prefix
assert "%d.%d" % sys.version_info[:2] == os.environ["PYTHON_VERSION"], sys.version

import torch
import torchaudio
import onnxruntime
import tensorrt
import triton

assert torch.version.cuda, "CUDA-enabled PyTorch is required"
PY
RUN "$VIRTUAL_ENV/bin/python" -m light_tts.server.api_server --help > /dev/null

EXPOSE 8080
ENTRYPOINT ["/usr/local/tts/.venv/bin/python", "-m", "light_tts.server.api_server", "--host", "0.0.0.0", "--port", "8080"]
CMD ["--model_dir", "./pretrained_models/CosyVoice2-0.5B-finetune-v1"]

FROM light-tts AS light-tts-with-model
# Build the TensorRT engine on the deployment GPU.
COPY --from=tts_model --exclude=*.plan / ./pretrained_models/CosyVoice2-0.5B-finetune-v1/
RUN set -eu; \
    model_dir=./pretrained_models/CosyVoice2-0.5B-finetune-v1; \
    model_link=$(find "$model_dir" -type l -print -quit); \
    if [ -n "$model_link" ]; then echo "Unresolved model symlink: $model_link" >&2; exit 1; fi

FROM ${TTSFRD_BASE_STAGE} AS light-tts-with-ttsfrd
COPY --from=ttsfrd_resources --exclude=*.whl / ./pretrained_models/CosyVoice-ttsfrd/resource/

FROM light-tts AS default-image
